# ============================================================
# 复制为 .env 后按需修改：  cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会进仓库
# ============================================================

# ---------- LLM 配置 ----------
# 二选一：deepseek 或 qwen
LLM_PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-请替换成你自己的Key
LLM_MODEL=deepseek-chat

# 通义千问 DashScope（OpenAI 兼容模式）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
DASHSCOPE_API_KEY=sk-请替换成你自己的Key

# ---------- Qdrant 配置 ----------
# docker compose 会用 environment 覆盖成 qdrant；本地直连时用 localhost
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=kb_qa

# ---------- Embedding 配置 ----------
# 首次调用会自动下载模型（约 95 MB），缓存在 hf_cache 卷里
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ---------- 检索配置 ----------
# 注意：RETRIEVAL_CANDIDATES / RERANK_CANDIDATES 目前还没有被代码使用（见 README 已知限制）
RETRIEVAL_CANDIDATES=15
RERANK_CANDIDATES=10
TOP_K=3

# ---------- HuggingFace 端点 ----------
# 必须写成 https://... 的纯地址，行尾不要跟注释，否则注释会被当成地址的一部分
# 模型只在"本地无缓存"时才会从这里下载；已有缓存则直接离线加载，不走网络
# 镜像站跳转行为不稳定：307 同站相对跳转可用；308 跨站绝对跳转会让 huggingface_hub 报
# "Distant resource does not seem to be on huggingface.co"，此时换回官方端点
HF_ENDPOINT=https://hf-mirror.com
# 设为 1 表示完全不联网（模型已下载好、或网络不通时用）；
# 首次部署且本地没有缓存时必须保持 0，否则会直接报找不到模型
HF_HUB_OFFLINE=0

# ---------- 上传目录 ----------
UPLOAD_DIR=documents

# ---------- Redis 配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 会话历史过期时间（秒）
SESSION_EXPIRE_SECONDS=3600
