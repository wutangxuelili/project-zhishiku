# ============================================================
# 复制为 .env 后按需修改：  cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会进仓库
# ============================================================

# ---------- LLM 配置 ----------
# 二选一：deepseek 或 qwen
LLM_PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-请替换成你自己的Key
LLM_MODEL=deepseek-chat

# 通义千问 DashScope（OpenAI 兼容模式）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
DASHSCOPE_API_KEY=sk-请替换成你自己的Key

# ---------- Qdrant 配置 ----------
# 容器内由 compose 覆盖为 qdrant；本地直连时用 localhost
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=kb_qa

# ---------- Embedding 配置 ----------
# 首次调用自动下载（约 95 MB），缓存在 hf_cache 卷里
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ---------- 检索配置 ----------
# RETRIEVAL_CANDIDATES / RERANK_CANDIDATES 暂未被代码使用（见 README 已知限制）
RETRIEVAL_CANDIDATES=15
RERANK_CANDIDATES=10
# 检索片段数：接口不传 top_k 时取它，上限 20
TOP_K=3

# ---------- HuggingFace 端点 ----------
# 必须写成纯地址，行尾不要跟注释
# 镜像站跳转不稳定；若报 "Distant resource does not seem to be on huggingface.co" 则换回官方端点
HF_ENDPOINT=https://hf-mirror.com
# 1 = 完全不联网；本地没有模型缓存时开启会直接报错
HF_HUB_OFFLINE=0

# ---------- 上传目录 ----------
UPLOAD_DIR=documents

# ---------- 中间件在宿主机上的端口（容器内端口不变）----------
# 6379 被本机其他程序（例如 Windows 服务 Redis）占用时改成 16379
QDRANT_HOST_PORT=6333
REDIS_HOST_PORT=6379

# ---------- 镜像版本 ----------
# 服务端要与 requirements.txt 里的 qdrant-client 保持同一条 minor 线；
# 升级时两边一起改并重新入库验证，不要降到比现有数据卷更旧的版本
QDRANT_IMAGE=qdrant/qdrant:v1.19.1
REDIS_IMAGE=redis:7.4-alpine

# ---------- 前端（仅本地开发模式）----------
# 容器内由 compose 覆盖为 http://backend:8000
BACKEND_URL=http://127.0.0.1:8000

# ---------- Redis 配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 留空则容器内使用默认密码 kb-qa-local-dev（只绑本机，够用；对外暴露请改掉）
REDIS_PASSWORD=
# 会话历史过期时间（秒）
SESSION_EXPIRE_SECONDS=3600
